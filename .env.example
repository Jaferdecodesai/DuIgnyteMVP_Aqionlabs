# LOCAL DEVELOPMENT / LOOPBACK PRODUCTION PREVIEW ONLY
# Copy to .env.local. Do not commit .env.local.
APP_ORIGIN=http://127.0.0.1:4633
# Replace locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RELAY_ALLOW_LOCAL_STORAGE=true
RELAY_SQLITE_PATH=.data/relay.sqlite
RELAY_WRITES_ENABLED=true
DEMO_ACCESS_CODE=

# CLOUDFLARE: production is configured in wrangler.jsonc and a Worker secret.
# Follow docs/CLOUDFLARE.md. Do not upload .env.local or .dev.vars.
# OPTIONAL NODE/MYSQL HOSTING: enter values in the hosting environment panel.
# APP_ORIGIN=https://your-exact-domain.example
# NODE_ENV=production
# RELAY_ALLOW_LOCAL_STORAGE=false
# SESSION_SECRET=<independent random secret>
# DEMO_ACCESS_CODE=<independent shared demo access code>
# MYSQL_HOST=<value shown by your database panel>
# MYSQL_PORT=3306
# MYSQL_DATABASE=<database name>
# MYSQL_USER=<database user>
# MYSQL_PASSWORD=<database password>
# MYSQL_TLS=true
# Keep TLS verification on for remote databases. See docs/HOSTINGER.md
# for a provider-confirmed same-host connection that has no TLS endpoint.
