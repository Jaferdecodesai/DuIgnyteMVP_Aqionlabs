{
  "name": "aqion-relay-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4633",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:coverage && npm run build && npm run build:cloudflare && wrangler deploy --dry-run",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev --port 4650 --inspector-port 9235",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "check:cloudflare": "npm run typecheck && npm run test:coverage && npm run build:cloudflare && wrangler deploy --dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mysql2": "^3.15.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "4.151.0"
  }
}
