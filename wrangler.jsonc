{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aqionrelaydumvp",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".cloudflare-build/out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY_SQL", "class_name": "RelayWorkspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayWorkspace"] }],
  "vars": {
    "APP_ORIGIN": "https://aqionrelaydumvp.jafermn.workers.dev",
    "RELAY_WRITES_ENABLED": "true",
    "DEMO_ACCESS_CODE": ""
  },
  "observability": { "enabled": true }
}
